{
  "name": "polyglot-compute-worker",
  "version": "1.0.0",
  "description": "A cross-language compute worker framework that enables state full/less workers with structured communications",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <24.0.0"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "coverage": "c8 node --test 'test/**/*.test.ts'",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LRagji/polyglot-compute-worker.git"
  },
  "keywords": [
    "cross",
    "language",
    "state-less",
    "state-full",
    "lambda"
  ],
  "author": "Laukik",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/LRagji/polyglot-compute-worker/issues"
  },
  "homepage": "https://github.com/LRagji/polyglot-compute-worker#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sinon": "^17.0.0",
    "c8": "^10.0.0",
    "sinon": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "c8": {
    "all": true,
    "include": ["src/**/*.ts"],
    "exclude": [
      "**/*.d.ts",
      "node_modules/",
      "dist/"
    ],
    "reporter": ["text", "html", "lcov"],
    "lines": 80,
    "functions": 80,
    "branches": 80,
    "statements": 80,
    "skip-full": false
  }
}